{
  "$schema": "https://app.flightcontrol.dev/schema.json",
  "environments": [
    {
      "id": "preview",
      "name": "Preview",
      "region": "eu-west-1",
      "source": {
        "pr": true,
        "filter": {
          "toBranches": ["develop"]
        }
      },
      "services": [
        {
          "id": "pubhub-contentful-user-guide-app",
          "name": "pubhub-contentful-user-guide-preview",
          "buildType": "nixpacks",
          "installCommand": "export NPM_TOKEN=${NPM_TOKEN} && echo \"//registry.npmjs.org/:_authToken=${NPM_TOKEN}\" > .npmrc && npm install --legacy-peer-deps",
          "buildCommand": "npm run build:ci",
          "cpu": 1,
          "memory": 2,
          "containerInsights": false,
          "minInstances": 1,
          "maxInstances": 1,
          "versionHistoryCount": 10,
          "basePath": ".",
          "envVariables": {},
          "autoscaling": {
            "cpuThreshold": 70,
            "memoryThreshold": 70,
            "cooldownTimerSecs": 300,
            "requestsPerTarget": 500
          },
          "includeEnvVariablesInBuild": true,
          "type": "fargate",
          "healthCheckPath": "/",
          "enableCloudfrontSwr": false
        }
      ]
    },
    {
      "id": "development",
      "name": "Development",
      "region": "eu-west-1",
      "source": {
        "branch": "develop",
        "pr": false,
        "trigger": "push"
      },
      "services": [
        {
          "id": "pubhub-contentful-user-guide-development",
          "name": "pubhub-contentful-user-guide-development",
          "buildType": "nixpacks",
          "installCommand": "export NPM_TOKEN=${NPM_TOKEN} && echo \"//registry.npmjs.org/:_authToken=${NPM_TOKEN}\" > .npmrc && npm install --legacy-peer-deps",
          "buildCommand": "npm run build:ci",
          "cpu": 2,
          "memory": 3.5,
          "containerInsights": false,
          "minInstances": 1,
          "maxInstances": 3,
          "versionHistoryCount": 10,
          "basePath": ".",
          "envVariables": {},
          "autoscaling": {
            "cpuThreshold": 70,
            "memoryThreshold": 70,
            "cooldownTimerSecs": 300,
            "requestsPerTarget": 500
          },
          "includeEnvVariablesInBuild": true,
          "type": "web",
          "target": {
            "type": "ecs-ec2",
            "clusterInstanceSize": "t3.medium",
            "clusterMaxInstances": 10,
            "clusterMinInstances": 1
          },
          "healthCheckPath": "/",
          "enableCloudfrontSwr": false,
          "port": 3000
        }
      ]
    },
    {
      "id": "staging",
      "name": "Staging",
      "region": "eu-west-1",
      "source": {
        "branch": "staging",
        "pr": false,
        "trigger": "push"
      },
      "services": [
        {
          "id": "pubhub-contentful-user-guide-staging",
          "name": "pubhub-contentful-user-guide-staging",
          "buildType": "nixpacks",
          "installCommand": "export NPM_TOKEN=${NPM_TOKEN} && echo \"//registry.npmjs.org/:_authToken=${NPM_TOKEN}\" > .npmrc && npm install --legacy-peer-deps",
          "buildCommand": "npm run build:ci",
          "cpu": 2,
          "memory": 3.5,
          "containerInsights": false,
          "minInstances": 1,
          "maxInstances": 3,
          "versionHistoryCount": 10,
          "basePath": ".",
          "envVariables": {},
          "autoscaling": {
            "cpuThreshold": 70,
            "memoryThreshold": 70,
            "cooldownTimerSecs": 300,
            "requestsPerTarget": 500
          },
          "includeEnvVariablesInBuild": true,
          "type": "web",
          "target": {
            "type": "ecs-ec2",
            "clusterInstanceSize": "t3.medium",
            "clusterMaxInstances": 12,
            "clusterMinInstances": 1
          },
          "healthCheckPath": "/",
          "enableCloudfrontSwr": false,
          "port": 3000
        }
      ]
    },
    {
      "id": "production",
      "name": "Production",
      "region": "eu-west-1",
      "source": {
        "branch": "main",
        "pr": false,
        "trigger": "push"
      },
      "services": [
        {
          "id": "pubhub-contentful-user-guide-production",
          "name": "pubhub-contentful-user-guide-production",
          "buildType": "nixpacks",
          "installCommand": "export NPM_TOKEN=${NPM_TOKEN} && echo \"//registry.npmjs.org/:_authToken=${NPM_TOKEN}\" > .npmrc && npm install --legacy-peer-deps",
          "buildCommand": "npm run build:ci",
          "cpu": 2,
          "memory": 3.5,
          "containerInsights": false,
          "minInstances": 1,
          "maxInstances": 3,
          "versionHistoryCount": 10,
          "basePath": ".",
          "envVariables": {},
          "autoscaling": {
            "cpuThreshold": 70,
            "memoryThreshold": 70,
            "cooldownTimerSecs": 300,
            "requestsPerTarget": 200
          },
          "includeEnvVariablesInBuild": true,
          "type": "web",
          "target": {
            "type": "ecs-ec2",
            "clusterInstanceSize": "t3.medium",
            "clusterMaxInstances": 10,
            "clusterMinInstances": 1
          },
          "healthCheckPath": "/",
          "enableCloudfrontSwr": false,
          "port": 3000
        }
      ]
    }
  ]
}
